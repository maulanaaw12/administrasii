
:root {
    --cream: #f7f4ee;
    --paper: #fffdf8;
    --ink: #24231f;
    --muted: #88847b;
    --line: #e5e0d6;
    --accent: #a66b4f;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: var(--cream);
    color: var(--ink);
    font-family: "DM Sans", sans-serif;
    line-height: 1.7;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    width: 100%;
    object-fit: cover;
}

.navbar {
    max-width: 1440px;
    margin: auto;
    padding: 25px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
}

.logo {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -1.5px;
}

.logo span {
    color: var(--accent);
    font-family: "Playfair Display", serif;
    font-style: italic;
}

nav {
    display: flex;
    gap: 32px;
}

nav a,
.socials a {
    font-size: 13px;
    transition: color .3s;
}

nav a:hover,
.socials a:hover {
    color: var(--accent);
}

.hero {
    max-width: 1440px;
    margin: auto;
    padding: 65px 7% 90px;
    min-height: 670px;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 65px;
    align-items: center;
}

.eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent);
}

.hero h1,
.section-heading h2,
.contact h2 {
    font-family: "Playfair Display", serif;
    font-weight: 500;
    letter-spacing: -2px;
    line-height: 1.12;
}

.hero h1 {
    font-size: clamp(58px, 7vw, 94px);
    margin: 24px 0;
}

h1 em,
h2 em {
    color: var(--accent);
    font-weight: 500;
}

.intro {
    color: #706c64;
    font-size: 14px;
    max-width: 420px;
    line-height: 2;
}

.button {
    display: inline-block;
    margin-top: 30px;
    padding: 13px 23px;
    border: 1px solid var(--ink);
    font-size: 12px;
    transition: .3s;
}

.button:hover {
    background: var(--ink);
    color: white;
}

.hero-bottom {
    display: flex;
    gap: 30px;
    margin-top: 75px;
    font-size: 9px;
    letter-spacing: 1.2px;
    color: var(--muted);
}

.hero-visual {
    position: relative;
    padding: 0 24px 30px 0;
}

.portrait {
    height: 460px;
    object-position: center 35%;
    filter: saturate(.78);
}

.hero-visual::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    border: 1px solid #c8b8a6;
    top: 18px;
    left: 18px;
    z-index: -1;
}

.photo-note {
    position: absolute;
    bottom: 0;
    left: -28px;
    background: var(--paper);
    padding: 14px 22px;
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 14px;
    box-shadow: 0 5px 25px #00000008;
}

.vertical-text {
    position: absolute;
    right: -18px;
    top: 20px;
    writing-mode: vertical-rl;
    font-size: 9px;
    letter-spacing: 3px;
}

.section {
    padding: 110px 7%;
}

.about {
    background: var(--paper);
}

.section-heading {
    margin-bottom: 48px;
}

.section-heading h2 {
    font-size: clamp(38px, 5vw, 58px);
    margin-top: 12px;
}

.about-grid {
    display: grid;
    grid-template-columns: .8fr 1fr;
    gap: 85px;
    align-items: center;
    max-width: 1050px;
    margin: auto;
}

.about-photo {
    height: 380px;
    filter: saturate(.7);
}

.about-content p {
    font-size: 14px;
    color: #706c64;
    margin-bottom: 22px;
    line-height: 2;
}

.signature {
    font-family: "Playfair Display", serif;
    font-style: italic;
    color: var(--accent);
    font-size: 24px;
    margin-top: 30px;
}

.works .section-heading {
    text-align: center;
}

.muted {
    color: var(--muted);
    font-size: 13px;
    margin-top: 12px;
}

.work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 45px 28px;
    max-width: 1100px;
    margin: auto;
}

.work-card:nth-child(2) {
    margin-top: 65px;
}

.work-card:nth-child(3) {
    width: 90%;
}

.work-card img {
    height: 290px;
    filter: saturate(.75);
    transition: filter .4s, transform .4s;
}

.work-card {
    overflow: hidden;
}

.work-card:hover img {
    filter: saturate(1);
    transform: scale(1.025);
}

.work-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 17px;
}

.work-meta h3 {
    font-family: "Playfair Display", serif;
    font-size: 20px;
    font-weight: 500;
}

.work-meta p {
    color: var(--muted);
    font-size: 11px;
    margin-top: 4px;
}

.work-meta > span {
    font-size: 20px;
}

.contact {
    text-align: center;
    background: #eae3d8;
    padding-top: 100px;
    padding-bottom: 90px;
}

.contact h2 {
    font-size: clamp(52px, 7vw, 82px);
    margin: 22px 0;
}

.contact > p {
    font-size: 13px;
    color: #706c64;
}

.button-dark {
    background: var(--ink);
    color: white;
}

.button-dark:hover {
    background: transparent;
    color: var(--ink);
}

.socials {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin-top: 35px;
}

footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 7%;
    gap: 15px;
    font-size: 10px;
    color: var(--muted);
}

footer .logo {
    color: var(--ink);
    font-size: 20px;
}

footer > a:last-child {
    letter-spacing: 1px;
}

@media (max-width: 760px) {
    .navbar {
        padding: 20px 6%;
    }

    nav {
        gap: 14px;
    }

    nav a {
        font-size: 11px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 55px 7% 75px;
        gap: 48px;
    }

    .hero h1 {
        font-size: 65px;
    }

    .hero-bottom {
        margin-top: 45px;
        gap: 15px;
        flex-wrap: wrap;
    }

    .hero-visual {
        width: 90%;
        margin: auto;
    }

    .portrait {
        height: 400px;
    }

    .section {
        padding: 75px 7%;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .about-photo {
        height: 320px;
    }

    .work-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .work-card:nth-child(2),
    .work-card:nth-child(3) {
        margin-top: 0;
        width: 100%;
    }

    .work-card img {
        height: 260px;
    }

    footer {
        flex-wrap: wrap;
        font-size: 9px;
    }
}

@media (max-width: 380px) {
    nav {
        gap: 10px;
    }

    nav a {
        font-size: 10px;
    }

    .hero h1 {
        font-size: 53px;
    }

    .portrait {
        height: 320px;
    }

    .hero-bottom {
        font-size: 8px;
    }
}
